generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Analysis {
    id              String          @id @default(uuid())
    createdAt       DateTime        @default(now())
    userId          String?
    inputText       String
    emotionLabel    String
    summary         String
    recommendations Json?
    narrative       String?
    energyCategory  EnergyCategory?
    rawJson         Json?
}

enum JournalMoodCategory {
    POSITIVE
    CALM
    ANXIOUS
    SAD
    ANGRY
    BURNOUT
    NEUTRAL
}

model Journal {
    id             String              @id @default(uuid())
    userId         String
    title          String
    content        String
    moodLabel      String
    moodCategory   JournalMoodCategory
    moodConfidence Float?
    summary        String
    rawJson        Json?
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt

    @@index([userId, createdAt])
}

model ChatSession {
    id        String        @id @default(uuid())
    userId    String
    title     String?
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
    messages  ChatMessage[]
}

model ChatMessage {
    id        String   @id @default(uuid())
    sessionId String
    role      String
    content   String
    metadata  Json?
    createdAt DateTime @default(now())

    session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum Gender {
    MALE
    FEMALE
}

enum UserRole {
    CLIENT
    PSYCHOLOGIST
}

enum VerificationStatus {
    PENDING
    VERIFIED
    REJECTED
}

enum VerificationDocType {
    KTP
    FACE_WITH_KTP
    STR_LICENSE
}

enum BookingStatus {
    PENDING_PAYMENT
    PAID
    CONFIRMED
    CANCELLED
}

enum PaymentStatus {
    UNPAID
    PAID
    FAILED
}

enum PsychologistMessageRole {
    USER
    PSYCHOLOGIST
}

enum ConsultationMethod {
    CHAT
    VOICE
    VIDEO
}

model Psychologist {
    id              String   @id @default(uuid())
    userId          String?  @unique
    fullName        String
    email           String?  @unique
    phoneNumber     String
    gender          Gender
    location        String
    clinicName      String
    specialization  String
    clientsHandled  Int
    yearsExperience Int
    nik             String   @unique
    strNumber       String   @unique
    bio             String?
    tags            String[]
    photoUrl        String?
    rating          Float    @default(0)
    reviewCount     Int      @default(0)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    education          PsychologistEducation[]
    reviews            PsychologistReview[]
    schedules          PsychologistSchedule[]
    documents          PsychologistVerificationDoc[]
    bookings           PsychologistBooking[]
    emailVerifications PsychologistEmailVerification[]
    user               User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PsychologistEducation {
    id             String @id @default(uuid())
    psychologistId String
    level          String
    institution    String
    year           Int?

    psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model PsychologistReview {
    id             String   @id @default(uuid())
    psychologistId String
    userId         String
    rating         Int
    comment        String?
    createdAt      DateTime @default(now())

    psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model PsychologistSchedule {
    id             String  @id @default(uuid())
    psychologistId String
    dayOfWeek      Int
    startTime      String
    endTime        String
    isAvailable    Boolean @default(true)

    psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model PsychologistVerificationDoc {
    id             String              @id @default(uuid())
    psychologistId String
    type           VerificationDocType
    url            String
    status         VerificationStatus  @default(PENDING)
    createdAt      DateTime            @default(now())

    psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

    @@unique([psychologistId, type])
}

model PsychologistEmailVerification {
    id             String             @id @default(uuid())
    psychologistId String
    email          String
    token          String             @unique
    status         VerificationStatus @default(PENDING)
    expiresAt      DateTime
    createdAt      DateTime           @default(now())

    psychologist Psychologist @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model PsychologistBooking {
    id             String             @id @default(uuid())
    psychologistId String
    userId         String
    fullName       String             @default("Unknown")
    notes          String?
    method         ConsultationMethod @default(CHAT)
    price          Int                @default(0)
    scheduledAt    DateTime
    status         BookingStatus      @default(PENDING_PAYMENT)
    paymentStatus  PaymentStatus      @default(UNPAID)
    createdAt      DateTime           @default(now())

    psychologist Psychologist          @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
    messages     PsychologistMessage[]
}

model User {
    id          String   @id
    email       String?
    displayName String?
    role        UserRole
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    clientProfile ClientProfile?
    psychologist  Psychologist?
}

model ClientProfile {
    id        String    @id @default(uuid())
    userId    String    @unique
    username  String
    birthDate DateTime?
    gender    Gender?
    photoUrl  String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PsychologistMessage {
    id         String                  @id @default(uuid())
    bookingId  String
    senderRole PsychologistMessageRole
    senderId   String
    content    String
    createdAt  DateTime                @default(now())

    booking PsychologistBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum EnergyCategory {
    POSITIVE
    NEGATIVE
    NEUTRAL
}

model PartnerQueue {
    id        String         @id @default(uuid())
    userId    String
    energy    EnergyCategory
    createdAt DateTime       @default(now())
}

model PartnerMatch {
    id        String           @id @default(uuid())
    userAId   String
    userBId   String
    energyA   EnergyCategory
    energyB   EnergyCategory
    status    String
    createdAt DateTime         @default(now())
    messages  PartnerMessage[]
}

model PartnerMessage {
    id        String   @id @default(uuid())
    matchId   String
    userId    String
    content   String
    createdAt DateTime @default(now())

    match PartnerMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model PartnerFavorite {
    id        String   @id @default(uuid())
    userId    String
    partnerId String
    createdAt DateTime @default(now())
}

model PartnerBlock {
    id            String   @id @default(uuid())
    userId        String
    blockedUserId String
    reason        String?
    createdAt     DateTime @default(now())
}

model PartnerReport {
    id             String   @id @default(uuid())
    userId         String
    reportedUserId String
    reason         String
    createdAt      DateTime @default(now())
}
